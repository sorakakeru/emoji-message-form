<!DOCTYPE html>

<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<meta name="format-detection" content="telephone=no">
<meta name="robots" content="noindex,nofollow,noarchive">
<meta name="pinterest" content="nopin">
<title>{% if bodyClass == 'admin' %}admin {% endif %}{{ title }}</title>
<link rel="stylesheet" href="{% if bodyClass == 'admin' %}../{% else %}./{% endif %}css/style.css">
{% if bodyClass != 'admin' %}<script src="./js/script.js" defer></script>{% endif %}
</head>
<body class="{{ bodyClass }}">

<div class="wrapper">

  <header class="header">
    {% if bodyClass == 'admin' %}
      <div class="back"><a href="../">back</a></div>
    {% else %}
      {% if siteName %}<div class="back"><a href="{{ siteURL }}">{{ siteName }}</a></div>{% endif %}
    {% endif %}

    <h1>{{ title }}</h1>
    {% if description %}<p class="description">{{ description|nl2br }}</p>{% endif %}
  </header>

  <main class="main">
    {% block main %}{% endblock %}
  </main>

  <footer class="footer">
    {% if siteName %}<p><a href="{{ siteURL }}">{{ siteName }}</a></p>{% endif %}
    {% if adminView == true %}<p><a href="{{ adminURL }}">* admin</a></p>{% endif %}
  </footer>

</div>

</body>
</html>