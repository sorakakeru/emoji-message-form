{% extends 'base.html.twig' %}

{% block main %}

  {% if isAdmin %}
    <div class="logout_area">
      <form action="" method="post">
        <input type="hidden" name="token" value="{{ token }}">
        <button type="submit" name="logout">管理画面からログアウトする</button>
      </form>
    </div>
  {% endif %}

  {% for msg in error %}
    <p class="msg error">{{ msg }}</p>
  {% endfor %}

  {# logFileExistsチェック #}
  {% if not logFileExists %}
    <p class="msg error">データ保存用jsonファイルがありません</p>
  {% else %}

    {% if isAdmin %}

      {% if not results %}
        {% if not error %}<p class="results">まだデータはありません</p>{% endif %}
      {% else %}

        <p class="results">データ：全{{ total }}件</p>

        <ul class="result_data">
          {% for item in results %}
            <li>
              <dl>
                <dt><time datetime="{{ item.date }}">{{ item.date }}</time> {{ item.emoji }}</dt>
                <dd>{{ item.message|nl2br }}</dd>
              </dl>
            </li>
          {% endfor %}
        </ul>

        <nav class="navigation">
          {% if pager > 1 %}
            <div class="nav prev"><a href="./index.php?page={{ pager - 1 }}">←</a></div>
          {% endif %}
          <ol>
            {% if pager > 3 %}
              <li><a href="./index.php?page=1">1</a></li>
              <li>...</li>
            {% endif %}

            {% for p in (pager - 1)..(pager + 1) %}
              {% if p > 0 and p <= totalPages %}
                <li>
                  {% if p == pager %}
                    <span class="current">{{ p }}</span>
                  {% else %}
                    <a href="./index.php?page={{ p }}">{{ p }}</a>
                  {% endif %}
                </li>
              {% endif %}
            {% endfor %}

            {% if pager < totalPages - 2 %}
              <li>...</li>
              <li><a href="./index.php?page={{ totalPages }}">{{ totalPages }}</a></li>
            {% endif %}

          </ol>
          {% if pager < totalPages %}
            <div class="nav next"><a href="./index.php?page={{ pager + 1 }}">→</a></div>
          {% endif %}
        </nav>

      {% endif %}

    {% else %}
      <div class="form_area">
        <form action="" method="post" id="lginForm">
          <input type="hidden" name="token" value="{{ token }}">
          <dl>
            <dt>login password...</dt>
            <dd><input type="password" name="password"></dd>
          </dl>

          <div class="btn_area">
            <button type="submit" name="send">管理者用</button>
          </div>
        </form>
      </div>
    {% endif %}

  {% endif %}

{% endblock %}
