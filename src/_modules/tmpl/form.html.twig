<form action="" method="post" id="msgForm">
  <input type="hidden" name="token" value="{{ token }}">
  <ul class="emoji_list">
    {% for key, value in emojiList %}
      <li><label for="form_emoji{{ key }}"><input type="radio" name="emoji" id="form_emoji{{ key }}" value="emoji{{ key }}">{{ value }}</label></li>
    {% endfor %}
  </ul>
  <dl>
    <dt><label for="form_message">メッセージ</label></dt>
    <dd>
      <textarea name="message" id="form_message"></textarea>
      <p class="count">（あと<span data-maxcount="{{ maxCount }}">{{ maxCount }}</span>文字入力できます）</p>
    </dd>
  </dl>
  <div class="btn_area">
    <button type="submit" name="send">送信</button>
  </div>
</form>