{% extends 'base.html.twig' %}

{% block main %}

  {% if not logFileExists %}
    <p class="msg error">データ保存用jsonファイルがありません</p>
  {% else %}

    <div class="form_area">

      {% if sendSuccess %}
        <p class="msg success">{{ thanxMsg }}</p>
      {% endif %}

      {% if not emojiList %}
        <p class="msg error">絵文字が設定されていません</p>
      {% else %}

        {% for msg in error %}
          <p class="msg error">{{ msg }}</p>
        {% endfor %}

        {{ include('form.html.twig') }}

      {% endif %}

    </div>

  {% endif %}

{% endblock %}